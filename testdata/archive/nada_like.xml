  <dataDscr>
    <varGrp ID="VG1" type="multipleResp" var="V3 V4" name="assets">
      <labl>Household assets</labl>
    </varGrp>
    <var ID="V1" name="hhid" files="F1" intrvl="discrete">
      <location StartPos="1" EndPos="6" width="6" fileid="F1"/>
      <labl>
        Household
        identifier
      </labl>
      <qstn>
        <preQTxt>
          Interviewer: copy the number
          from the cover sheet.
        </preQTxt>
        <qstnLit>
          What is the household number?
        </qstnLit>
      </qstn>
      <valrng>
        <range UNITS="INT" min="1" max="999999"/>
      </valrng>
      <sumStat type="vald">1200</sumStat>
      <sumStat type="invd">0</sumStat>
      <sumStat type="min">1</sumStat>
      <sumStat type="max">1200</sumStat>
      <varFormat type="numeric" schema="other"/>
    </var>
    <var ID="V2" name="hhid" files="F2" intrvl="discrete">
      <location StartPos="1" EndPos="6" width="6" fileid="F2"/>
      <labl>Household identifier</labl>
      <varFormat type="numeric" schema="other"/>
    </var>
    <var ID="V3" name="tv" files="F1" intrvl="discrete">
      <location StartPos="7" EndPos="7" width="1" fileid="F1"/>
      <labl xml:lang="en">Owns a television</labl>
      <labl xml:lang="ko">텔레비전 보유</labl>
      <qstn ID="Q3" responseDomainType="category">
        <qstnLit>
          Does the household own
          a working television?
        </qstnLit>
      </qstn>
      <invalrng>
        <item VALUE="9"/>
      </invalrng>
      <sumStat type="vald">1180</sumStat>
      <sumStat type="invd">20</sumStat>
      <catgry>
        <catValu>
          1
        </catValu>
        <labl>Yes</labl>
        <catStat type="freq">900</catStat>
        <catStat type="freq" wgtd="wgtd" wgt-var="V5">912.4</catStat>
      </catgry>
      <catgry excls="false">
        <catValu>2</catValu>
        <labl>No</labl>
        <catStat type="freq">280</catStat>
      </catgry>
      <catgry missing="Y">
        <catValu>9</catValu>
        <labl>Don't know</labl>
        <catStat type="freq">20</catStat>
      </catgry>
      <varFormat type="numeric" schema="other"/>
      <notes>Asked of all households.</notes>
    </var>
    <var ID="V4" name="radio" files="F1" intrvl="discrete">
      <location StartPos="8" EndPos="8" width="1" fileid="F1"/>
      <labl>Owns a radio</labl>
      <qstn>
        <qstnLit>Does the household own a radio?</qstnLit>
        <ivuInstr>Show card 3.</ivuInstr>
        <qstnLit>Count only working sets.</qstnLit>
      </qstn>
      <catgry>
        <catValu>1</catValu>
        <labl>Yes</labl>
      </catgry>
      <catgry>
        <catValu>2</catValu>
        <labl>No</labl>
      </catgry>
      <varFormat type="numeric" schema="other"/>
    </var>
    <var ID="V5" name="wgt" files="F1" intrvl="contin" wgt="wgt">
      <location StartPos="9" EndPos="16" width="8" fileid="F1"/>
      <labl>Household weight</labl>
      <varFormat type="numeric" schema="other"/>
    </var>
    <notes>Variables are listed in file order.</notes>
